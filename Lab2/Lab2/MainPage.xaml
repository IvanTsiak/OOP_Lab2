<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab2.MainPage"
             Title="">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Оберіть файл для аналізу" FontSize="Medium" FontAttributes="Bold" />

            <Button Text="Обрати XML-файл..." 
                    Clicked="OnSelectXmlClicked" 
                    HorizontalOptions="Fill" />

            <Label x:Name="SelectedXmlFileLabel" 
                   Text="Файл не обрано" 
                   FontSize="Small" 
                   TextColor="Grey" />

            <Frame Padding="10" BorderColor="LightGray">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Параметри пошуку" 
                           FontSize="Medium" 
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="10">
                        <Label Text="Назва:" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
                        <Entry x:Name="TitleEntry" Grid.Row="0" Grid.Column="1" Placeholder="Шукати в назві..."/>

                        <Label Text="Автор:" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
                        <Picker x:Name="AuthorPicker" Grid.Row="1" Grid.Column="1" BackgroundColor="#2B2B2B">
                        </Picker>

                        <Label Text="Кафедра:" Grid.Row="2" Grid.Column="0" VerticalOptions="Center"/>
                        <Picker x:Name="DepartmentPicker" Grid.Row="2" Grid.Column="1" BackgroundColor="#2B2B2B">
                        </Picker>

                        <Label Text="Категорія:" Grid.Row="3" Grid.Column="0" VerticalOptions="Center"/>
                        <Picker x:Name="CategoryPicker" Grid.Row="3" Grid.Column="1" BackgroundColor="#2B2B2B">
                        </Picker>
                    </Grid>

                    <Label Text="Оберіть метод аналізу"
                           FontSize="Medium"
                           FontAttributes="Bold"
                           Margin="0,10,0,0"/>

                    <Picker x:Name="StrategyPicker" BackgroundColor="#2B2B2B">
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">

                <Button x:Name="SearchButton" 
                        Text="Пошук" 
                        Clicked="OnSearchClicked" 
                        IsEnabled="False"
                        HorizontalOptions="FillAndExpand" />

                <Button x:Name="TransformButton" 
                        Text="Трансформувати в HTML" 
                        Clicked="OnTransformClicked" 
                        IsEnabled="False" 
                        HorizontalOptions="FillAndExpand" />
            </HorizontalStackLayout>

            <Button x:Name="ClearButton" 
                    Text="Очистити" 
                    Clicked="OnClearClicked" 
                    IsEnabled="False" 
                    BackgroundColor="Gray" 
                    TextColor="White"/>

            <Label Text="Результати:" FontSize="Medium" FontAttributes="Bold" />
            <Label x:Name="StatusLabel" TextColor="Green" FontSize="Small" />

            <ListView x:Name="ResultsListView"
                      HeightRequest="300"
                      HasUnevenRows="True"
                      SeparatorVisibility="None"
                      ItemTapped="OnResultTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame Margin="0,5" 
                                   Padding="10" 
                                   BackgroundColor="#1E1E1E" 
                                   BorderColor="#333333"
                                   CornerRadius="8">

                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding Type}" 
                                           FontSize="10" 
                                           TextColor="#AAAAAA" 
                                           TextTransform="Uppercase"/>

                                    <Label Text="{Binding Title}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="White"/>

                                    <Label Text="{Binding AuthorsDisplay, StringFormat='Автори: {0}'}" 
                                           FontSize="12" 
                                           TextColor="Gray"/>

                                    <Label Text="{Binding Department}" 
                                           FontSize="10" 
                                           TextColor="#00A2FF" 
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnDefinitions="2*, *" 
                  ColumnSpacing="15" 
                  Margin="0,20,0,20">

                <Button Grid.Column="0"
                        Text="Вийти з програми"
                        Clicked="OnExitClicked"
                        BackgroundColor="#CC0000" 
                        TextColor="White"
                        HorizontalOptions="Fill"/>

                <Button Grid.Column="1"
                        Text="Не натискати!"
                        Clicked="OnRRClicked"
                        BackgroundColor="#330000"
                        TextColor="#FF9999"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
